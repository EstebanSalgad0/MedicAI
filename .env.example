# Copia este archivo a .env y completa los valores.  cp .env.example .env
# Nunca subas el .env al repositorio.

# ---------- Infraestructura ----------
HTTP_PORT=8080
POSTGRES_USER=medicai
POSTGRES_PASSWORD=cambia-esta-clave
APP_TZ=America/Santiago
LOG_LEVEL=INFO
# Secreto compartido para llamadas entre servicios (genera uno: openssl rand -hex 32)
INTERNAL_TOKEN=

# ---------- WhatsApp Business ----------
# Proveedor: auto | 360dialog | meta. Sin credenciales corre en modo DRY_RUN (registra en vez de enviar).
WHATSAPP_PROVIDER=auto
# 360dialog (recomendado): API key del número en el 360dialog Hub
D360_API_KEY=
D360_BASE_URL=https://waba-v2.360dialog.io
# Secreto que 360dialog envía en cada webhook para verificar el origen (openssl rand -hex 32)
WEBHOOK_SECRET=

# Meta Cloud API directa (alternativa a 360dialog)
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_API_VERSION=v21.0
WHATSAPP_VERIFY_TOKEN=
# App Secret de Meta: activa la verificación de firma X-Hub-Signature-256 (recomendado)
WHATSAPP_APP_SECRET=
WHATSAPP_DRY_RUN=auto
# Reacción al mensaje del paciente para mostrar que el bot lo vio (vacío = sin reacción)
WHATSAPP_REACTION_EMOJI=👀

# ---------- NLU ----------
RASA_CONFIDENCE_THRESHOLD=0.70
# Respaldo con LLM cuando Rasa duda: none | anthropic | openai (API compatible, p. ej. Ollama local)
LLM_PROVIDER=none
LLM_API_KEY=
LLM_MODEL=claude-haiku-5-5
LLM_BASE_URL=http://ollama:11434/v1
LLM_TIMEOUT_SECONDS=4

# ---------- Orquestador ----------
SESSION_TTL_SECONDS=1800
SURVEY_ENABLED=true
SURVEY_COOLDOWN_HOURS=24

# ---------- Farmacia ----------
# local = inventario del dashboard · http = sistema de farmacia externo (STOCK_API_URL)
STOCK_PROVIDER=local
STOCK_API_URL=
# Carga un inventario de ejemplo en los 5 CESFAM (solo demostraciones)
SEED_DEMO_STOCK=true

# ---------- Dashboard y analítica ----------
DASHBOARD_USER=admin
DASHBOARD_PASSWORD=cambia-esta-clave
# Cuentas extra opcionales: usuario:clave,usuario2:clave2
DASHBOARD_EXTRA_USERS=
# Al menos 32 caracteres aleatorios (openssl rand -hex 32)
JWT_SECRET=
# Sal para seudonimizar teléfonos en la analítica (no cambiarla después de iniciar el piloto)
ANALYTICS_SALT=

# ---------- Scheduler ----------
TICK_SECONDS=60
